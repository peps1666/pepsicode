{
  "name": "pepsicode-client",
  "version": "2.0.0",
  "description": "Pepsicode local coding agent desktop client",
  "author": "pepsicode contributors",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "backend:build": "python ../scripts/build_desktop_backend.py",
    "release:zip": "npm test && npm run backend:build && npm run build && electron-builder --win --x64 --dir --publish never && python ../scripts/archive_desktop.py && node scripts/release-checksum.cjs",
    "electron:build": "npm run release:zip",
    "release:smoke": "node scripts/smoke-desktop-ui.cjs",
    "start": "electron .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "shiki": "^1.12.0",
    "zustand": "^4.5.4",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.pepsicode.client",
    "productName": "Pepsicode",
    "artifactName": "Pepsicode-${version}-${os}-${arch}.${ext}",
    "electronDist": "node_modules/electron/dist",
    "beforePack": "scripts/check-backend.cjs",
    "afterPack": "scripts/windows-launcher.cjs",
    "win": {
      "target": [{ "target": "zip", "arch": ["x64"] }],
      "signAndEditExecutable": false
    },
    "extraResources": [{ "from": "../build/desktop-backend/pepsicode-server", "to": "backend" }],
    "extraFiles": [
      { "from": "../docs/portable-readme.txt", "to": "使用说明.txt" },
      { "from": "../LICENSE", "to": "LICENSE-pepsicode.txt" }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  }
}
